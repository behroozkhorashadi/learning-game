#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/../.." && pwd)"

UV_BIN="$repo_root/.figma/make/.uv/bin/uv"
if [[ ! -x "$UV_BIN" ]]; then
  curl -fsSL https://astral.sh/uv/install.sh | HOME="$repo_root/.figma/make/.uv-home" INSTALLER_NO_MODIFY_PATH=1 UV_INSTALL_DIR="$repo_root/.figma/make/.uv/bin" sh
fi

"$UV_BIN" venv "$repo_root/backend/.venv" --python python3 --seed --clear
"$UV_BIN" pip install --python "$repo_root/backend/.venv/bin/python3" -r "$repo_root/backend/requirements.txt"

cd "$repo_root/frontend"
exec npm ci
