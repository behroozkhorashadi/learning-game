#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/../.." && pwd)"

python3 -m venv --without-pip "$repo_root/backend/.venv"
curl -fsSL https://bootstrap.pypa.io/get-pip.py | "$repo_root/backend/.venv/bin/python3"
env -u PYTHONPATH "$repo_root/backend/.venv/bin/pip" install --disable-pip-version-check -r "$repo_root/backend/requirements.txt"

cd "$repo_root/frontend"
exec npm ci
