{
  // The Playwright e2e specs: run on Node, but their page.evaluate callbacks run in the browser.
  "extends": "./tsconfig.strict.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "nodenext",
    "allowImportingTsExtensions": true
  },
  "include": ["e2e/**/*.ts"]
}
