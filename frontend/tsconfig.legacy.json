{
  // Legacy app code at its pre-guardrail strictness. This project only shrinks:
  // migrating a file (see MIGRATION.md) moves it under tsconfig.app.json's
  // strict settings. Do not add new files here — new code is suffixed and strict.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.legacy.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": { "@app/*": ["./src/*"] },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.pure.*", "src/**/*.effect.*", "src/**/*.assembly.*", "src/**/*.test.*.ts", "src/**/*.test.*.tsx"]
}
