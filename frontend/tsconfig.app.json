{
  // New-style app code: every file under src/ that carries a <color>.<kind> suffix.
  "extends": "./tsconfig.strict.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "paths": { "@app/*": ["./src/*"] }
  },
  "include": ["src/**/*.pure.*", "src/**/*.effect.*", "src/**/*.assembly.*", "src/**/*.test.*.ts", "src/**/*.test.*.tsx"]
}
