flowchart TB
  client["React SPA"] -- "/api/*, /static/*" --> main

  main["app/main.py<br/>uvicorn entry: app = assemble_app(load_settings())"]

  subgraph NEW["Guardrailed — app/&lt;feature&gt;/&lt;name&gt;_&lt;kind&gt;_&lt;color&gt;.py (assembly → effect → pure)"]
    comp["app/composition (assembly)<br/>AppSettings (env + backend/.env)<br/>assemble_app: CORS, /static, lifespan seeds, every router"]
    todo["todo/<br/>/api/examples/todos (the worked example)"]
    profiles["profiles/<br/>/profiles, /unlock, /photos, /profile-photos/remix<br/>passwords (scrypt), photo files, demo seeding"]
    admin["admin/<br/>/admin/login + the admin password check"]
    play["play/<br/>/games, /items/next, /attempts, /ratings, /verifications<br/>games/ (item generators, incl. zombie_horde), Loop A (pure)"]
    events["events/<br/>the append-only event log"]
    badges["badges/<br/>/profiles/{id}/badges, /stats<br/>seeded badges, awarding, live stats"]
    pieces["pieces/<br/>/pieces, /illustrations, /revisions, /remixes, /turns<br/>illustration files"]
    practice["practice/<br/>/api/practice-config"]
    pathfinder["pathfinder/<br/>/completions, /maps, /published-maps"]
    armory["armory/<br/>/profiles/{id}/armory, /rounds, /purchases, /art<br/>Zombie Horde points ledger + catalog, art studio"]
    crash["crash_reports/<br/>POST /api/client-errors<br/>→ logs/client_errors.log"]
  end

  sqlite[("SQLite<br/>same tables and columns as before")]
  files[("static/<br/>profile-avatars/, illustrations/")]
  openai["OpenAI Images API"]

  main --> comp
  comp -- "builds + wires<br/>(features never import each other)" --> todo & profiles & admin & play & events & badges & pieces & practice & pathfinder & armory & crash
  profiles -- "is_admin_password" --> admin
  profiles -- "erase a profile's data" --> play & events & badges & pieces & practice & pathfinder & armory
  play -- "birth year, practice config" --> profiles & practice
  play & pieces & badges -- "append events" --> events
  play & pieces -- "after an attempt / piece:<br/>award badges" --> badges
  badges -- "history: attempts, ratings,<br/>pieces, event times" --> play & pieces & events
  practice -- "game rules" --> play
  practice & pathfinder & pieces & badges & armory -- "profile lookups" --> profiles
  todo & profiles & play & events & badges & pieces & practice & pathfinder & armory --> sqlite
  profiles & pieces --> files
  profiles -- "photo remix" --> openai
  armory -- "art studio (via the photo remixer)" --> openai
  pieces -- "illustrations" --> openai
