flowchart TB
  client["React SPA"] -- "/api/*, /static/*" --> main

  main["app/main.py<br/>uvicorn entry: app = assemble_app(load_settings())"]

  subgraph NEW["Guardrailed — app/&lt;feature&gt;/&lt;name&gt;_&lt;kind&gt;_&lt;color&gt;.py (assembly → effect → pure)"]
    comp["app/composition (assembly)<br/>AppSettings (env + backend/.env)<br/>assemble_app: CORS, /static, lifespan seeds, every router"]
    todo["todo/<br/>/api/examples/todos (the worked example)"]
    profiles["profiles/<br/>/profiles, /unlock, /photos, /profile-photos/remix<br/>passwords (scrypt), photo files, demo seeding"]
    admin["admin/<br/>/admin/login + the admin password check"]
    play["play/<br/>/games, /items/next, /attempts, /ratings, /verifications<br/>games/ (item generators, incl. zombie_horde), Loop A (pure)"]
    events["events/<br/>the append-only event log"]
    badges["badges/<br/>/profiles/{id}/badges, /badges/new, /celebrated, /art, /stats<br/>seeded badges, awarding, live stats + day breakdown,<br/>personal badge art (worker pool)"]
    pieces["pieces/<br/>/pieces, /illustrations, /revisions, /remixes, /turns<br/>illustration files"]
    practice["practice/<br/>/api/practice-config"]
    pathfinder["pathfinder/<br/>/completions, /maps, /published-maps"]
    armory["armory/<br/>/profiles/{id}/armory, /rounds, /purchases, /art, /looks<br/>Zombie Horde points ledger + catalog, art studio,<br/>looks (skin, paint, emblem, hung art)"]
    replays["replays/<br/>/profiles/{id}/horde/replays<br/>last 3 Zombie Horde round recordings"]
    parents["parents/<br/>/parents, /unlock, /kids, /kids/{id}/report<br/>parent accounts (scrypt), kid progress report:<br/>skills, trouble spots, facts grid, time, trends, insights (pure)"]
    crash["crash_reports/<br/>POST /api/client-errors<br/>→ logs/client_errors.log"]
    engagement["engagement/<br/>POST /api/engagement + admin summary<br/>aggregated active milliseconds by semantic area"]
  end

  sqlite[("SQLite<br/>same tables and columns as before")]
  files[("static/<br/>profile-avatars/, illustrations/, badge-art/")]
  openai["OpenAI Images API"]

  main --> comp
  comp -- "builds + wires<br/>(features never import each other)" --> todo & profiles & admin & play & events & badges & pieces & practice & pathfinder & armory & replays & parents & crash & engagement
  profiles -- "is_admin_password" --> admin
  profiles -- "erase a profile's data" --> play & events & badges & pieces & practice & pathfinder & armory & replays & engagement
  play -- "birth year, practice config" --> profiles & practice
  play & pieces & badges -- "append events" --> events
  play & pieces -- "after an attempt / piece:<br/>award badges" --> badges
  badges -- "history: attempts, ratings,<br/>pieces, event times" --> play & pieces & events
  practice -- "game rules" --> play
  profiles -- "parent exists?" --> parents
  parents -- "linked kids, unlink" --> profiles
  parents -- "history: attempts, items shown,<br/>level changes, ratings, badges, puzzles" --> play & events & badges & pathfinder
  parents -- "is_admin_password" --> admin
  practice & pathfinder & pieces & badges & armory & replays -- "profile lookups" --> profiles
  todo & profiles & play & events & badges & pieces & practice & pathfinder & armory & replays & parents & engagement --> sqlite
  profiles & pieces & badges --> files
  profiles -- "photo remix" --> openai
  armory -- "art studio (via the photo remixer)" --> openai
  pieces -- "illustrations" --> openai
  badges -- "badge art (low quality, WebP)" --> openai
