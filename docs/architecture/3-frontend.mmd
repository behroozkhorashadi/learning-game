flowchart TB
  main["main.tsx<br/>ErrorBoundary + errorReporting"] --> app

  app["App.tsx<br/>state-driven screen router<br/>profile, gameId, editing, admin..."]
  dev["dev/ screens via ?screen=<br/>ZombieHitLab, WeaponPOC, ZombiePOC"]
  app -. "DEV only" .-> dev

  subgraph SCREENS["Legacy screens — src/games"]
    picker["GamePicker<br/>+ EquationOutbreakSettings"]
    gWord["Writing games<br/>PromptForge, StyleRemixLab,<br/>TagTeamStory, ClueMaster"]
    gMath["Math games<br/>ZombieMathBlaster"]
    gPath["Pathfinder"]
    meta["Storybook"]
  end

  subgraph COMP["Legacy components — src/components"]
    arena["framework/ZombieArena + R3F scene<br/>EquationOutbreakScene, ZombieCharacter3D,<br/>EquationBlaster, ApproachLane, MuzzleFlash"]
    pathc["Pathfinder UI<br/>Board, Editor, MapBuilder, PlayTest,<br/>LevelGallery, MyMaps, PublishedMaps"]
    write["Writing UI<br/>WritingSurface,<br/>IllustrationReveal, CoachPanel"]
  end

  subgraph LIB["Legacy logic — src/lib (pure, unit-tested)"]
    zlib["Zombie engine<br/>zombieWaveEngine, raycastOutcome,<br/>laneNavigation, rootMotion, zombieRoster"]
    plib["Pathfinder engine<br/>Rules, Solver, Generator,<br/>Difficulty, Levels, usePathfinderPlay"]
    plat["Platform adapters<br/>gameAudio, errorReporting,<br/>pathfinderProgress, pathfinderCustomMaps"]
  end

  subgraph NEW["Guardrailed features — src/&lt;feature&gt;/&lt;name&gt;.&lt;color&gt;.&lt;kind&gt;.ts(x)"]
    root["main/<br/>dev_screens.assembly.main"]
    profiles["profiles/<br/>picker, create, unlock, edit screens (bind* + assemble*),<br/>photo panel (camera + remix), form &amp; password fields,<br/>CardShell, ProfileAvatar, AVATAR_OPTIONS"]
    admin["admin/<br/>AdminLogin + AdminPanel<br/>(X-Admin-Password, a UX gate)"]
    session["session/<br/>session shell: SessionStart, SessionComplete,<br/>RatingPrompt, ParentVerify, HandoffPencil, ProgressBar"]
    den["den/<br/>DenButton, DenCard, DenChip, DenFlipCard,<br/>DenJar, DenTile, icons, icon_paths"]
    query["query/<br/>useQuery, useReloadableQuery + QueryState (server state)"]
    apiad["api/<br/>profiles_api, admin_api, todos_api (zod at the door)<br/>openapi_schema (generated), http types"]
    flags["flags/<br/>feature flags, read in assembly only"]
    practice["practice/<br/>usePracticeSession: next item → attempt →<br/>handoff/verify → rating (api/practice_api)"]
    pgames["syllable_builder/, equation_builder/<br/>bind* games over practice/"]
    tiles["tiles/<br/>TileBoard + pure placement rules"]
    badges["badges/<br/>BadgesView (pure) + bindBadges"]
    speech["speech/<br/>Speech: word clips, falling back to speechSynthesis"]
    ids["ids/<br/>v4 UUIDs from getRandomValues (works on http LAN)"]
    boundary["boundary/<br/>AsyncBoundary"]
    example["examples/todo/<br/>the worked example to copy"]
  end

  types["types/generated.ts (legacy)<br/>from backend models"]
  api[["FastAPI /api/*"]]
  assets[("public/ GLB models, images, audio")]

  app --> picker & gWord & gMath & gPath & meta
  app -- "assemble* once:<br/>picker, create, unlock, edit" --> profiles
  app -- "assembleAdminPanel() once" --> admin
  app -- "assembleBadges() once" --> badges
  app -- "assembleSyllableBuilder(),<br/>assembleEquationBuilder() once" --> pgames
  pgames --> practice & tiles & session & speech
  practice --> apiad & ids
  tiles --> den
  badges --> query & apiad & den
  admin --> profiles & query & apiad & den
  dev --> root --> example
  gWord --> write
  gMath --> arena
  gWord & gMath --> session
  gPath --> pathc
  picker & meta --> den
  write & pathc --> den
  session --> den
  profiles --> query & apiad & den
  profiles -- "injected camera<br/>(navigator.mediaDevices)" --> browser[["Browser camera"]]
  example --> apiad & flags
  apiad -- "injected fetch" --> api
  arena --> zlib
  arena --> assets
  pathc --> plib
  gPath --> plat
  gWord & gMath --> plat
  gWord & gMath & write -- "assembleSpeech(), assembleRandomId()" --> speech & ids
  picker & gWord & gMath & meta -- "fetch (legacy)" --> api
  plat -- "fetch" --> api
  SCREENS -.-> types
  LIB -.-> types
