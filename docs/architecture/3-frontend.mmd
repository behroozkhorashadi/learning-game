  pathfinder --> query & apiad & den & ids
  pathfinder -- "injected timers, dialogs,<br/>window focus" --> browserWin[["Browser window"]]
  app -- "assembleStoryLibrary() once" --> library
  library --> writing & query & apiad & den
  app -- "assemble* once:<br/>picker, create, unlock, edit" --> profiles
  app -- "assembleAdminPanel() once" --> admin
  app -- "assembleBadges() once" --> badges
  app -- "assembleSyllableBuilder(),<br/>assembleEquationBuilder() once" --> pgames
  pgames --> practice & tiles & session & speech
  practice --> apiad & ids
  tiles --> den
  badges --> query & apiad & den
  admin --> profiles & query & apiad & den
  dev --> root --> example
  writing --> timing & apiad & den
  app -- "assemblePromptForge(), assembleStyleRemix(),<br/>assembleTagTeam(), assembleClueMaster() once" --> wgames
  wgames --> writing & den
  session --> den
  profiles --> query & apiad & den
  profiles -- "injected camera<br/>(navigator.mediaDevices)" --> browser[["Browser camera"]]
  example --> apiad & flags
  apiad -- "injected fetch" --> api
  app -- "assembleZombieMathBlaster(),<br/>assembleOutbreakSettings() once" --> outbreak
  dev -- "assemble* once" --> zombie_lab & outbreak
  outbreak -- "injected Viewport" --> arena
  outbreak --> zombies & blaster & motion & session & den & apiad & speech & ids
  arena --> zombies & science_fair & blaster & boundary
  science_fair --> arena
  zombie_lab --> arena & zombies & blaster
