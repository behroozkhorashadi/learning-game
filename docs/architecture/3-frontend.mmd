flowchart TB
  main["main.tsx"] --> app
  main -- "assembleErrorHandling()" --> errors

  app["App.tsx<br/>state-driven screen router<br/>profile, gameId, editing, admin..."]
  dev["dev/ DevScreenPicker via ?screen="]
  app -. "DEV only" .-> dev

  subgraph NEW["Guardrailed features — src/&lt;feature&gt;/&lt;name&gt;.&lt;color&gt;.&lt;kind&gt;.ts(x)"]
    root["main/<br/>dev_screens.assembly.main"]
    profiles["profiles/<br/>picker, create, unlock, edit screens (bind* + assemble*),<br/>photo panel (camera + remix), form &amp; password fields,<br/>CardShell, ProfileAvatar, AVATAR_OPTIONS"]
    admin["admin/<br/>AdminLogin + AdminPanel<br/>(X-Admin-Password, a UX gate)"]
    pathfinder["pathfinder/<br/>game, level select, map builder (editor, My Maps,<br/>play-test), published maps, dev level gallery (bind* + assemble*);<br/>pure engine: rules, solver, difficulty, generator, levels"]
    session["session/<br/>session shell: SessionStart, SessionComplete,<br/>RatingPrompt, ParentVerify, HandoffPencil, ProgressBar"]
    den["den/<br/>DenButton, DenCard, DenChip, DenFlipCard,<br/>DenJar, DenTile, icons, icon_paths"]
    query["query/<br/>useQuery, useReloadableQuery + QueryState (server state)"]
    apiad["api/<br/>profiles, admin, pathfinder, practice, pieces, badges,<br/>practice_config, todos (zod at the door)<br/>openapi_schema (generated), http types"]
    flags["flags/<br/>feature flags, read in assembly only"]
    practice["practice/<br/>usePracticeSession: next item → attempt →<br/>handoff/verify → rating (api/practice_api)"]
    pgames["syllable_builder/, equation_builder/<br/>bind* games over practice/"]
    tiles["tiles/<br/>TileBoard + pure placement rules"]
    writing["writing/<br/>WritingSurface, CoachPanel, ModifierDeck,<br/>bindIllustrationReveal (pieces_api + timers)"]
    wgames["prompt_forge/, style_remix/, tag_team/, clue_master/<br/>bind* writing games over writing/"]
    home["home/<br/>GamePickerView + bindGamePicker (kid home)"]
    errors["errors/<br/>ReportError capability, bound ErrorBoundary,<br/>window error listeners (assembly)"]
    timing["timing/<br/>Timers capability + useScheduled"]
    library["story_library/<br/>shelf + reader + home entry card<br/>(bindStoryLibrary, injected confirm)"]
    badges["badges/<br/>BadgesView (pure) + bindBadges"]
    speech["speech/<br/>Speech: word clips, falling back to speechSynthesis"]
    ids["ids/<br/>v4 UUIDs from getRandomValues (works on http LAN)"]
    boundary["boundary/<br/>AsyncBoundary (works inside a Canvas too)"]
    outbreak["outbreak/<br/>Equation Outbreak: bindZombieArena + useArenaSession,<br/>fact_fluency brain, game audio, practice settings"]
    arena["arena/<br/>OutbreakViewport + OutbreakScene (R3F),<br/>lane navigation, raycast tags + outcome"]
    zombies["zombies/<br/>wave engine (pure), roster, characters,<br/>ZombieCharacter3D + useZombieRig"]
    science_fair["science_fair/<br/>the gym: booths, portal, lanes,<br/>colliders that block shots"]
    blaster["blaster/<br/>EquationBlaster, MuzzleFlash (pixel textures),<br/>ChargeHud, pose maths, dev tuning panel"]
    motion["motion/<br/>usePrefersReducedMotion over an injected preference"]
    zombie_lab["zombie_lab/<br/>dev: hit lab (labels shots for the e2e eval),<br/>zombie and weapon POC scenes"]
    example["examples/todo/<br/>the worked example to copy"]
  end

  types["types/generated.ts (legacy)<br/>from backend models"]
  api[["FastAPI /api/*"]]
  assets[("public/ GLB models, images, audio")]

  app -- "assembleGamePicker() once" --> home
  home --> query & apiad & den
  errors --> apiad & den
  app -- "assemblePathfinder() once" --> pathfinder
