flowchart TB
  entry["main/entry.assembly.main<br/>(index.html loads it): error handling,<br/>then the root on #root"]
  entry -- "assembleErrorHandling()" --> errors
  entry -- "assembleRoot()" --> app

  subgraph NEW["src/ — every file is &lt;feature&gt;/&lt;name&gt;.&lt;color&gt;.&lt;kind&gt;.ts(x)"]
    app["main/<br/>bindApp: one Screen union (app_navigation),<br/>every screen injected; assembleRoot picks app or dev"]
    dev["main/ dev screens (DEV, ?screen=)<br/>bindDevScreens: mock-data demos + live screens"]
    profiles["profiles/<br/>picker, create, unlock, edit screens (bind* + assemble*),<br/>photo panel (camera + remix), form &amp; password fields,<br/>CardShell, ProfileAvatar, AVATAR_OPTIONS"]
    admin["admin/<br/>AdminLogin + AdminPanel<br/>(X-Admin-Password, a UX gate)"]
    pathfinder["pathfinder/<br/>game, level select, map builder (editor, My Maps,<br/>play-test), published maps, dev level gallery (bind* + assemble*),<br/>backdrop art from the armory looks;<br/>pure engine: rules, solver, difficulty, generator, levels"]
    session["session/<br/>session shell: SessionStart, SessionComplete,<br/>RatingPrompt, ParentVerify, HandoffPencil, ProgressBar"]
    den["den/<br/>DenButton, DenCard, DenChip, DenFlipCard,<br/>DenJar, DenTile, icons, icon_paths"]
    query["query/<br/>useQuery, useReloadableQuery + QueryState (server state)"]
    apiad["api/<br/>profiles, parents, admin, pathfinder, practice, pieces, badges,<br/>practice_config, armory, todos (zod at the door)<br/>openapi_schema (generated), http types"]
    flags["flags/<br/>feature flags, read in assembly only"]
    practice["practice/<br/>usePracticeSession: next item → attempt →<br/>handoff/verify → rating (api/practice_api)"]
    pgames["syllable_builder/, equation_builder/<br/>bind* games over practice/"]
    tiles["tiles/<br/>TileBoard + pure placement rules"]
    writing["writing/<br/>WritingSurface, CoachPanel, ModifierDeck,<br/>bindIllustrationReveal (pieces_api + timers)"]
    wgames["prompt_forge/, style_remix/, tag_team/, clue_master/<br/>bind* writing games over writing/"]
    home["home/<br/>GamePickerView + bindGamePicker (kid home)"]
    errors["errors/<br/>ReportError capability, bound ErrorBoundary,<br/>window error listeners (assembly)"]
    timing["timing/<br/>Timers capability + useScheduled"]
    library["story_library/<br/>shelf + reader + home entry card<br/>(bindStoryLibrary, injected confirm)"]
    badges["badges/<br/>Badges and prizes: BadgesView (pure) + bindBadges,<br/>medals, badge + streak details, reuses the art gallery;<br/>bindBadgeCelebrations (polls for new badges)"]
    parents["parents/<br/>parent mode: CreateParent, ParentLogin, ParentDashboard<br/>(FamilyOverview + KidReportView), SVG charts + grids"]
    speech["speech/<br/>Speech: word clips, falling back to speechSynthesis"]
    ids["ids/<br/>v4 UUIDs from getRandomValues (works on http LAN)"]
    boundary["boundary/<br/>AsyncBoundary (works inside a Canvas too)"]
    outbreak["outbreak/<br/>Equation Outbreak: bindZombieArena + useArenaSession,<br/>fact_fluency brain, game audio, practice settings"]
    arena["arena/<br/>OutbreakViewport + OutbreakScene (R3F),<br/>lane navigation, raycast tags + outcome"]
    zombies["zombies/<br/>wave engine (pure), roster, characters,<br/>ZombieCharacter3D + useZombieRig"]
    science_fair["science_fair/<br/>the gym: booths, portal, lanes,<br/>colliders that block shots"]
    blaster["blaster/<br/>EquationBlaster (paint, emblem badge), MuzzleFlash (pixel textures),<br/>ChargeHud, pose maths, dev tuning panel"]
    motion["motion/<br/>usePrefersReducedMotion over an injected preference"]
    horde["horde/<br/>Zombie Horde: bindZombieHorde + useHordeRound,<br/>pure engine (roaming, health, cover, grenades, push-backs),<br/>armory shop, art studio, Style Studio (paint, emblem,<br/>hung art), HordeViewport + HordeScene (R3F)"]
    zombie_lab["zombie_lab/<br/>dev: hit lab (labels shots for the e2e eval),<br/>zombie and weapon POC scenes"]
    example["examples/todo/<br/>the worked example to copy"]
  end
  api[["FastAPI /api/*"]]
  assets[("public/ GLB models, images, audio")]

  app -- "assembleGamePicker() once" --> home
  home --> query & apiad & den
  errors --> apiad & den
  app -- "assemblePathfinder() once" --> pathfinder
  dev -- "map builder, level gallery" --> pathfinder
  pathfinder --> query & apiad & den & ids
  pathfinder -- "injected timers, dialogs,<br/>window focus" --> browserWin[["Browser window"]]
  app -- "assembleStoryLibrary() once" --> library
  library --> writing & query & apiad & den
  app -- "assemble* once:<br/>picker, create, unlock, edit" --> profiles
  app -- "assembleAdminPanel() once" --> admin
  app -- "assembleCreateParent(), assembleParentLogin(),<br/>assembleParentDashboard() once" --> parents
  parents --> query & apiad & den & profiles
  profiles -- "ParentBadge on the picker" --> parents
  app -- "assembleBadges(),<br/>assembleBadgeCelebrations() once" --> badges
  app -- "assembleSyllableBuilder(),<br/>assembleEquationBuilder() once" --> pgames
  pgames --> practice & tiles & session & speech
  practice --> apiad & ids
  tiles --> den
  badges --> query & apiad & den & horde & timing & motion
  admin --> profiles & query & apiad & den
  app -. "DEV, ?screen=" .-> dev
  dev --> example
  writing --> timing & apiad & den
  app -- "assemblePromptForge(), assembleStyleRemix(),<br/>assembleTagTeam(), assembleClueMaster() once" --> wgames
  wgames --> writing & den
  session --> den
  profiles --> query & apiad & den
  profiles -- "injected camera<br/>(navigator.mediaDevices)" --> browser[["Browser camera"]]
  example --> apiad & flags
  apiad -- "injected fetch" --> api
  app -- "assembleZombieMathBlaster(),<br/>assembleOutbreakSettings() once" --> outbreak
  dev -- "assemble* once" --> zombie_lab & outbreak
  outbreak -- "injected Viewport" --> arena
  outbreak --> zombies & blaster & motion & session & den & apiad & speech & ids
  arena --> zombies & science_fair & blaster & boundary
  science_fair --> arena
  zombie_lab --> arena & zombies & blaster
  app -- "assembleZombieHorde() once" --> horde
  dev -- "live screen" --> horde
  horde --> zombies & arena & blaster & science_fair & outbreak & profiles & motion & den & query & apiad & speech & ids & boundary
  horde -- "injected timers, rAF,<br/>Web Audio, matchMedia" --> webapis
  zombies & blaster & science_fair -- "GLB models, audio" --> assets
  outbreak -- "injected timers, rAF,<br/>Web Audio, matchMedia" --> webapis[["Browser APIs"]]
