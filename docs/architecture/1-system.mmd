flowchart LR
  subgraph Users["People (home LAN)"]
    kid["Kid player<br/>tablet / laptop browser"]
    parent["Parent / admin"]
  end

  subgraph Browser["Browser runtime"]
    spa["React 19 SPA<br/>Vite build, TypeScript"]
    three["Three.js / R3F<br/>3D zombie arena"]
    webapis["Web Speech + Web Audio<br/>camera, localStorage"]
    glb[("public/ assets<br/>GLB models, word images, audio")]
  end

  subgraph Host["Home machine / Figma Make preview"]
    vite["Vite dev server :5173<br/>proxies /api and /static"]
    api["FastAPI + uvicorn :8000<br/>app.main + app/composition"]
    db[("SQLite<br/>learning_game.db")]
    static[("static/ dir<br/>generated illustrations, avatars")]
    env[".env<br/>ADMIN_PASSWORD, OPENAI_API_KEY"]
  end

  subgraph External["External services"]
    openai["OpenAI Images API<br/>generations + edits"]
  end

  subgraph Tooling["Dev tooling"]
    genapi["make gen-api<br/>OpenAPI export to src/api/ types<br/>(CI fails on drift)"]
    genassets["asset scripts<br/>word images, audio, badges"]
    e2e["Playwright e2e, on demand<br/>bundled Chromium, temp DB, ports 8100/5174"]
  end

  subgraph Guardrails["Guardrails (make preflight)"]
    felint["Frontend: oxlint + local plugin,<br/>tsc strict, cycle check, docs sync"]
    belint["Backend: ruff, pyright strict,<br/>import-linter, AST rules, cycles"]
    hook["pre-commit hook<br/>lint on staged files"]
    ci["GitHub Actions CI, 4 parallel jobs<br/>backend, FE static, unit, API contract<br/>+ Storybook in Chromium, nightly"]
  end

  kid --> spa
  parent --> spa
  spa --- three
  spa --- webapis
  spa --> glb
  spa -- "HTTP JSON /api/*" --> vite
  vite -- proxy --> api
  api -- SQLModel --> db
  api -- writes/serves --> static
  env -.-> api
  api -- "illustrations, photo remix" --> openai
  genapi -. "backend OpenAPI to FE types" .-> spa
  genassets -- uses --> openai
  genassets -. writes .-> glb
  e2e -. drives .-> spa
  hook -. "before commit" .-> felint & belint
  ci -. runs .-> felint & belint & genapi
