# Copy to backend/.env and fill in real values. backend/.env is gitignored.

OPENAI_API_KEY=

# Required — gates the admin screen's edit/remove-player actions (see
# backend/app/admin_auth.py). The server refuses to start without this set.
ADMIN_PASSWORD=

# Optional overrides — defaults shown.
# IMAGE_PROVIDER=openai
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1024x1024
