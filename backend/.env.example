# Copy to backend/.env and fill in real values. backend/.env is gitignored.

OPENAI_API_KEY=

# Gates the admin screen's edit/remove-player actions (see
# backend/app/admin_auth.py). Admin features are unavailable when unset.
ADMIN_PASSWORD=

# Optional overrides — defaults shown.
# IMAGE_PROVIDER=openai
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1024x1024

# Optional — seeds a second profile (id=2) on startup for a real named
# tester, kept local instead of hardcoded in the repo. Only LOCAL_SEED_PROFILE_NAME
# is required to opt in; the others default as shown. Set avatar to a key with a
# matching frontend/public/images/avatars/<avatar>.png on your machine, if you
# want a real photo instead of the initial-letter fallback.
# LOCAL_SEED_PROFILE_NAME=
# LOCAL_SEED_PROFILE_AVATAR=fox
# LOCAL_SEED_PROFILE_BIRTH_YEAR=2019
